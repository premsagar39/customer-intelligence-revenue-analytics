            "name": "Products",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                " Source = Csv.Document(File.Contents(DataRoot & \"processed/products.csv\"),[Delimiter=\",\",Encoding=65001,QuoteStyle=QuoteStyle.Csv]),",
                " Headers = Table.PromoteHeaders(Source,[PromoteAllScalars=true]),",
                " Typed = Table.TransformColumnTypes(Headers,{{\"StockCode\", type text}, {\"Description\", type text}},\"en-US\"),",
                " Indexed = Table.AddIndexColumn(Typed,\"ProductKey\",1,1,Int64.Type),",
                " Final = Table.AddColumn(Indexed,\"ProductLabel\",each [StockCode] & \" [\" & Text.From([ProductKey]) & \"]\",type text)",
                "in Final"
              ],
              "type": "m"
            }
          }
