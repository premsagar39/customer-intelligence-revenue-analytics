            "summarizeBy": "none"
          }
        ],
        "lineageTag": "9f53d22e-f120-4e2d-809b-b1050c8a31cd",
        "measures": [
          {
            "name": "Net Revenue",
            "description": "See powerbi/MEASURE_DEFINITIONS.md for context and scope.",
            "displayFolder": "Portfolio Measures",
            "expression": "SUM(Transactions[LineRevenue])",
            "formatString": "£#,0;−£#,0",
            "lineageTag": "4b03f14f-23ff-4b51-a636-171620a21b67"
          },
          {
            "name": "Gross Revenue",
            "description": "See powerbi/MEASURE_DEFINITIONS.md for context and scope.",
            "displayFolder": "Portfolio Measures",
            "expression": "SUM(Transactions[SalesRevenue])",
            "formatString": "£#,0",
            "lineageTag": "17183e20-a4ae-434b-8a48-7784d68f901c"
          },
          {
            "name": "Return Value",
            "description": "See powerbi/MEASURE_DEFINITIONS.md for context and scope.",
            "displayFolder": "Portfolio Measures",
            "expression": "SUM(Transactions[ReturnValue])",
            "formatString": "£#,0",
            "lineageTag": "f1c5584d-2403-4157-addb-5056ee8bfc66"
          },
          {
            "name": "Sales Orders",
            "description": "See powerbi/MEASURE_DEFINITIONS.md for context and scope.",
            "displayFolder": "Portfolio Measures",
            "expression": "CALCULATE(DISTINCTCOUNT(Transactions[InvoiceNo]),Transactions[LineType]=\"Sale\")",
            "formatString": "#,0",
            "lineageTag": "eb71cc82-b5dd-4420-9312-0f59fed54916"
          },
          {
            "name": "Average Order Value",
            "description": "See powerbi/MEASURE_DEFINITIONS.md for context and scope.",
            "displayFolder": "Portfolio Measures",
            "expression": "DIVIDE([Gross Revenue],[Sales Orders])",
            "formatString": "£#,0.00",
            "lineageTag": "5b33ad9c-30c3-4287-88a2-d8e46fca014b"
          },
          {
            "name": "Return to Gross",
            "description": "See powerbi/MEASURE_DEFINITIONS.md for context and scope.",
            "displayFolder": "Portfolio Measures",
            "expression": "DIVIDE([Return Value],[Gross Revenue])",
            "formatString": "0.0%",
            "lineageTag": "9c0a3494-8b02-438c-bab8-75f541e83619"
          },
          {
            "name": "Accepted Lines",
            "description": "See powerbi/MEASURE_DEFINITIONS.md for context and scope.",
            "displayFolder": "Portfolio Measures",
            "expression": "COUNTROWS(Transactions)",
            "formatString": "#,0",
            "lineageTag": "d35fa032-dbb8-47e3-821e-29bf7c84cc7f"
          },
          {
            "name": "Units Sold",
            "description": "See powerbi/MEASURE_DEFINITIONS.md for context and scope.",
            "displayFolder": "Portfolio Measures",
            "expression": "CALCULATE(SUM(Transactions[Quantity]),Transactions[LineType]=\"Sale\")",
            "formatString": "#,0",
            "lineageTag": "939cb2d1-58b6-46a5-ae98-2764d9ee9c6b"
          },
          {
            "name": "Purchasing Customers",
            "description": "See powerbi/MEASURE_DEFINITIONS.md for context and scope.",
            "displayFolder": "Portfolio Measures",
            "expression": "CALCULATE(DISTINCTCOUNT(Transactions[CustomerID]),Transactions[LineType]=\"Sale\",Transactions[CustomerID]<>\"UNKNOWN\")",
            "formatString": "#,0",
            "lineageTag": "0c0e7bee-ef4b-413e-a788-114b4315cfc9"
          },
          {
            "name": "Repeat Customers",
            "description": "See powerbi/MEASURE_DEFINITIONS.md for context and scope.",
            "displayFolder": "Portfolio Measures",
            "expression": "COUNTROWS(FILTER(VALUES(Transactions[CustomerID]),Transactions[CustomerID]<>\"UNKNOWN\" && CALCULATE([Sales Orders])>=2))",
            "formatString": "#,0",
            "lineageTag": "a4664efe-281d-4d6d-810f-b206eef984e3"
          },
          {
            "name": "Repeat Customer Share",
            "description": "See powerbi/MEASURE_DEFINITIONS.md for context and scope.",
            "displayFolder": "Portfolio Measures",
            "expression": "DIVIDE([Repeat Customers],[Purchasing Customers])",
            "formatString": "0.0%",
            "lineageTag": "ab49e7ec-4441-44a1-9320-012f0816e12d"
          },
          {
            "name": "Anonymous Revenue Share",
            "description": "See powerbi/MEASURE_DEFINITIONS.md for context and scope.",
            "displayFolder": "Portfolio Measures",
            "expression": "DIVIDE(CALCULATE([Gross Revenue],Transactions[CustomerID]=\"UNKNOWN\"),[Gross Revenue])",
            "formatString": "0.0%",
            "lineageTag": "543fab48-25f2-499a-bcfa-9ca1205ce210"
          },
          {
            "name": "Active Products",
            "description": "See powerbi/MEASURE_DEFINITIONS.md for context and scope.",
            "displayFolder": "Portfolio Measures",
            "expression": "DISTINCTCOUNT(Transactions[ProductKey])",
            "formatString": "#,0",
            "lineageTag": "49dc5a90-32e2-49ee-8d36-b026346c7800"
          },
          {
            "name": "Markets",
            "description": "See powerbi/MEASURE_DEFINITIONS.md for context and scope.",
            "displayFolder": "Portfolio Measures",
            "expression": "DISTINCTCOUNT(Transactions[Country])",
            "formatString": "#,0",
            "lineageTag": "70b52434-591d-4754-a713-25052a3c44e1"
          },
          {
            "name": "Net Revenue Previous Month",
            "description": "See powerbi/MEASURE_DEFINITIONS.md for context and scope.",
            "displayFolder": "Portfolio Measures",
            "expression": "CALCULATE([Net Revenue],DATEADD(Dates[DateKey],-1,MONTH))",
            "formatString": "£#,0",
            "lineageTag": "4132e59d-0ae4-4803-be8f-000ea373575d"
          },
          {
            "name": "Net Revenue MoM",
            "description": "See powerbi/MEASURE_DEFINITIONS.md for context and scope.",
            "displayFolder": "Portfolio Measures",
            "expression": "DIVIDE([Net Revenue]-[Net Revenue Previous Month],[Net Revenue Previous Month])",
            "formatString": "0.0%",
            "lineageTag": "cef2287c-6771-48a2-ba9c-3bd8133bcf9b"
          },
          {
            "name": "Net Revenue YTD",
            "description": "See powerbi/MEASURE_DEFINITIONS.md for context and scope.",
            "displayFolder": "Portfolio Measures",
            "expression": "TOTALYTD([Net Revenue],Dates[DateKey])",
            "formatString": "£#,0",
            "lineageTag": "bce62120-1975-4ce2-833e-06ff881a92f1"
          },
          {
            "name": "Customer Revenue Share",
            "description": "See powerbi/MEASURE_DEFINITIONS.md for context and scope.",
            "displayFolder": "Portfolio Measures",
            "expression": "DIVIDE([Gross Revenue],CALCULATE([Gross Revenue],REMOVEFILTERS(Customers)))",
            "formatString": "0.0%",
            "lineageTag": "44620016-8ac2-4a17-95aa-3e413f1d7985"
          },
          {
            "name": "RFM Customers",
            "description": "See powerbi/MEASURE_DEFINITIONS.md for context and scope.",
            "displayFolder": "Portfolio Measures",
            "expression": "COUNTROWS(FILTER(Customers,NOT ISBLANK(Customers[Frequency])))",
            "formatString": "#,0",
            "lineageTag": "d14658b8-b249-479b-8372-6a9f9190ab5e"
          },
          {
            "name": "RFM Gross Spend",
            "description": "See powerbi/MEASURE_DEFINITIONS.md for context and scope.",
            "displayFolder": "Portfolio Measures",
            "expression": "SUM(Customers[Monetary])",
            "formatString": "£#,0",
            "lineageTag": "760aa9c6-49d7-4f09-a861-cbfe6dc96d13"
          },
          {
            "name": "RFM Mean Recency",
            "description": "See powerbi/MEASURE_DEFINITIONS.md for context and scope.",
            "displayFolder": "Portfolio Measures",
            "expression": "AVERAGE(Customers[Recency])",
            "formatString": "0.0",
            "lineageTag": "054275f0-92d8-4e92-abba-7a293f923fa5"
          },
          {
            "name": "RFM Top Decile Spend Share",
            "description": "See powerbi/MEASURE_DEFINITIONS.md for context and scope.",
            "displayFolder": "Portfolio Measures",
            "expression": "VAR C=FILTER(ALL(Customers),NOT ISBLANK(Customers[Monetary])) VAR N=ROUNDUP(COUNTROWS(C)*0.1,0) RETURN DIVIDE(SUMX(TOPN(N,C,Customers[Monetary],DESC,Customers[CustomerID],ASC),Customers[Monetary]),SUMX(C,Customers[Monetary]))",
            "formatString": "0.0%",
            "lineageTag": "3e36ef22-d86b-4049-ae95-2f782077b8ea"
          },
          {
            "name": "Cohort Retention",
            "description": "See powerbi/MEASURE_DEFINITIONS.md for context and scope.",
            "displayFolder": "Portfolio Measures",
            "expression": "DIVIDE(SUM(Cohorts[ActiveCustomers]),SUM(Cohorts[CohortSize]))",
            "formatString": "0.0%",
            "lineageTag": "7c277d79-af50-4a47-8157-d5c554a9b52e"
          },
          {
            "name": "Cohort Active Customers",
            "description": "See powerbi/MEASURE_DEFINITIONS.md for context and scope.",
            "displayFolder": "Portfolio Measures",
            "expression": "SUM(Cohorts[ActiveCustomers])",
            "formatString": "#,0",
            "lineageTag": "504ccd46-2e05-4c6c-99ff-2e8b5120f16a"
          }
        ],
        "partitions": [
          {
            "name": "Transactions",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                " Source = Csv.Document(File.Contents(DataRoot & \"processed/transactions.csv\"),[Delimiter=\",\",Encoding=65001,QuoteStyle=QuoteStyle.Csv]),",
                " Headers = Table.PromoteHeaders(Source,[PromoteAllScalars=true]),",
                " Typed = Table.TransformColumnTypes(Headers,{{\"LineID\", Int64.Type}, {\"InvoiceNo\", type text}, {\"StockCode\", type text}, {\"CustomerID\", type text}, {\"DateKey\", type datetime}, {\"InvoiceDate\", type datetime}, {\"Country\", type text}, {\"Quantity\", Int64.Type}, {\"UnitPrice\", type number}, {\"LineType\", type text}, {\"LineRevenue\", type number}, {\"SalesRevenue\", type number}, {\"ReturnValue\", type number}},\"en-US\"),",
                " Joined = Table.NestedJoin(Typed,{\"StockCode\"},Products,{\"StockCode\"},\"Product\",JoinKind.LeftOuter),",
                " Final = Table.ExpandTableColumn(Joined,\"Product\",{\"ProductKey\"},{\"ProductKey\"})",
                "in Final"
              ],
              "type": "m"
            }
          }
        ]
      },
